# Read by docker-compose.yml for the backend and frontend services.
# Copy to .env and adjust before running `docker compose up`.

# Signs/verifies JWTs — shared by backend (issues tokens) and frontend
# (verifies the admin session cookie locally). Must match between the two.
JWT_SECRET=change-me-in-production

# Seeded into the backend's AdminUser collection on every startup (updates
# the password if the account already exists). Change the password after
# first login.
ADMIN_EMAIL=admin@laqta.sa
ADMIN_PASSWORD=change-me-now
